{
  "name": "simple-ollama-connection",
  "productName": "Simple Ollama Connection",
  "version": "1.0.0",
  "description": "Connect to your local Ollama instance and chat with your LLMs",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"cd .. && npm run dev\" \"electron .\"",
    "build": "cd .. && npm run build",
    "package-mac": "electron-builder --mac",
    "package-win": "electron-builder --win",
    "package-all": "electron-builder --mac --win"
  },
  "author": "Simple Ollama Connection Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^29.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^7.0.2",
    "axios": "^1.6.2",
    "cors": "^2.8.5",
    "electron-is-dev": "^2.0.0",
    "electron-updater": "^6.6.2",
    "express": "^4.18.2"
  },
  "build": {
    "appId": "com.simpleollamaconnection.app",
    "productName": "Simple Ollama Connection",
    "files": [
      "main.js",
      "preload.js",
      "../dist/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "target": ["dmg", "zip"],
      "darkModeSupport": true
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    }

  }
}
